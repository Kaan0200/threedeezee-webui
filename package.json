{
  "name": "threedeezee",
  "version": "0.1.0",
  "files": [
    "dist",
    "NOTICE",
    "AI_POLICY.md"
  ],
  "module": "./dist/threedeezee.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/threedeezee.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaan0200/threedeezee-webui.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "example:dev": "vite --config example/vite.config.ts",
    "example:build": "vite build --config example/vite.config.ts",
    "lint:fix": "eslint ./src --ext .js,.ts --quiet --fix --ignore-path ./.gitignore",
    "lint:format": "prettier  --loglevel warn --write \"./**/*.{js,ts,css,md,json}\" ",
    "lint": "pnpm lint:format && pnpm lint:fix ",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.6.0",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "postcss": "^8.5.28",
    "postcss-import": "^14.1.0",
    "prettier": "^2.8.8",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "pre-commit": "lint",
  "license": "Apache-2.0",
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
