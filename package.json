{
  "name": "threedeezee",
  "version": "0.1.0",
  "description": "Tilted 2.5D camera rig for ordinary DOM content — pan, dolly, and parallax without dictating how you draw.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/threedeezee.js"
    },
    "./camera.css": "./dist/camera.css",
    "./theme.css": "./dist/camera-theme.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"['camera.css','camera-theme.css'].forEach(f=>require('fs').copyFileSync('src/'+f,'dist/'+f))\"",
    "lint:fix": "eslint ./src ./demo --ext .js,.ts --quiet --fix --ignore-path ./.gitignore",
    "lint:format": "prettier  --loglevel warn --write \"./**/*.{js,ts,css,md,json}\" ",
    "lint": "pnpm lint:format && pnpm lint:fix ",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "@typescript-eslint/parser": "^5.33.1",
    "autoprefixer": "^10.4.8",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "postcss": "^8.4.16",
    "postcss-import": "^14.1.0",
    "pre-commit": "^1.2.2",
    "prettier": "^2.7.1",
    "tailwindcss": "^3.1.8",
    "typescript": "^4.7.4",
    "vite": "^4.0.0"
  },
  "pre-commit": "lint"
}
